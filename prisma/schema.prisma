generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  role             String   @default("normal_user") // super_admin | official_partner | normal_user | ambassador
  ign              String?
  phone            String?
  status           String   @default("active") // active | suspended | deactivated
  isDeleted        Boolean  @default(false)
  password         String
  organizationId   String?
  organizationName String?
  createdAt        DateTime @default(now())
}

model OfficialCreator {
  id                  String   @id @default(cuid())
  name                String
  handle              String
  organizationName    String
  avatar              String
  bio                 String
  subscribers         String   @default("Official Partner")
  verified            Boolean  @default(true)
  status              String   @default("active") // active | suspended | deactivated
  isDeleted           Boolean  @default(false)
  email               String?
  phone               String?
  games               String   @default("[]")
  socials             String   @default("{}")
  totalTournaments    Int      @default(0)
  totalRegistrations  Int      @default(0)
  totalRdkFees        Float    @default(0)
  pendingRdkFees      Float    @default(0)
  paidRdkFees         Float    @default(0)
  createdAt           DateTime @default(now())
}

model Tournament {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  type                 String   @default("BR TOURNAMENT") // BR SCRIM | BR TOURNAMENT | AUCTION TOURNAMENT | CUSTOM TOURNAMENT
  creatorId            String?
  creatorName          String
  creatorHandle        String
  creatorAvatar        String?
  game                 String
  format               String
  banner               String
  teams                Int      @default(0)
  maxTeams             Int      @default(32)
  status               String   @default("registration_open") // DRAFT | PUBLISHED | REGISTRATION_OPEN | REGISTRATION_CLOSED | AUCTION | LIVE | FINISHED | CLOSED
  startDate            String
  prizePool            String
  entryFee             String
  entryType            String   @default("per_team") // per_team | per_player
  registeredTeamsCount Int      @default(0)
  isFeatured           Boolean  @default(false)
  auctionConfigured    Boolean  @default(false)
  upiId                String?
  upiName              String?
  upiQrUrl             String?
  rules                String?
  roomId               String?
  roomPassword         String?
  roomPublished        Boolean  @default(false)
  roadmap              String?
  pointsTable          String?
  streamUrl            String?
  streamTitle          String?
  streamStatus         String   @default("offline")
  scheduledMatchInfo   String?
  streamPlatform       String?
  settlementStatus     String   @default("PENDING") // PENDING | PAYMENT_SUBMITTED | UNDER_REVIEW | VERIFIED | REJECTED
  grossRevenue         Float    @default(0)
  rdkFee               Float    @default(0)
  partnerNet           Float    @default(0)
  isClosed             Boolean  @default(false)
  closedAt             DateTime?
  maxSquadSize         Int      @default(6)
  basePrice            Int      @default(5000)
  startingPurse        Int      @default(150000)
  createdAt            DateTime @default(now())
}

model RegisteredTeam {
  id              String   @id @default(cuid())
  tournamentId    String
  name            String
  captainName     String
  captainEmail    String
  captainPhone    String
  captainIgn      String
  players         String   @default("[]")
  status          String   @default("pending") // pending | verified | rejected
  utr             String?
  paymentProofUrl String?
  group           String?
  role            String?
  experience      String?
  achievements    String?
  clipUrl         String?
  ambassadorId    String?
  ambassadorName  String?
  registeredAt    DateTime @default(now())
}

model PaymentSubmission {
  id              String    @id @default(cuid())
  tournamentId    String
  tournamentName  String
  teamId          String
  teamName        String
  captainName     String
  amount          String
  utr             String
  screenshotUrl   String?
  status          String    @default("pending") // pending | approved | rejected
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?
  rejectionReason String?
}

model AuctionPlayer {
  id              String   @id @default(cuid())
  auctionId       String
  tournamentId    String
  name            String
  ign             String
  gameUid         String
  role            String   @default("Rusher")
  basePrice       Int      @default(5000)
  tier            String   @default("Tier 2 (Pro)")
  phone           String
  email           String
  clipUrl         String?  // Google Drive gameplay link / Video
  photoUrl        String?
  stats           String?
  status          String   @default("available") // available | on_auction | sold | unsold | re_auction
  soldPrice       Int?
  soldToTeam      String?
  paymentProofUrl String?
  paymentStatus   String   @default("verified")
  registeredAt    DateTime @default(now())
}

model EphemeralAuctionBidder {
  id             String   @id @default(cuid())
  auctionId      String
  teamName       String
  loginCode      String
  passkey        String
  allocatedPurse Int      @default(150000)
  spentAmount    Int      @default(0)
  group          String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
}

model Ambassador {
  id                String   @id @default(cuid())
  name              String
  email             String
  creatorId         String
  tournamentId      String
  tournamentName    String
  assignedTeamRange String
  phone             String?
  createdAt         DateTime @default(now())
}

model PlatformSettlement {
  id              String    @id @default(cuid())
  tournamentId    String    @unique
  tournamentName  String
  partnerId       String
  partnerName     String
  entryFee        Float     @default(0)
  approvedEntries Int       @default(0)
  grossRevenue    Float     @default(0)
  rdkFee          Float     @default(0)
  partnerNet      Float     @default(0)
  status          String    @default("PENDING") // PENDING | PAYMENT_SUBMITTED | UNDER_REVIEW | VERIFIED | REJECTED
  utr             String?
  screenshotUrl   String?
  paymentDate     String?
  notes           String?
  submittedAt     DateTime?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
}

model PlatformAuditLog {
  id           String   @id @default(cuid())
  tournamentId String?
  action       String
  actorId      String
  actorName    String
  actorRole    String
  details      String?
  oldValue     String?
  newValue     String?
  reason       String?
  createdAt    DateTime @default(now())
}

model AuctionReversal {
  id           String   @id @default(cuid())
  tournamentId String
  auctionId    String
  playerId     String
  playerIgn    String
  teamName     String
  soldPrice    Float
  reason       String
  reversedBy   String
  createdAt    DateTime @default(now())
}

