# ── Frontend (Netlify Environment Variables) ──
VITE_APP_NAME=RDK Esports
# Optional if using direct URL instead of Netlify proxy redirects:
VITE_API_URL=

# ── Backend (Railway Environment Variables) ──
PORT=5000
NODE_ENV=production
JWT_SECRET=rdk-esports-super-secret-key-2026
CLIENT_URL=https://your-site.netlify.app

# ── Database (Railway PostgreSQL) ──
# Railway automatically injects DATABASE_URL when you add PostgreSQL to your project
DATABASE_URL=postgresql://postgres:password@host:5432/railway
